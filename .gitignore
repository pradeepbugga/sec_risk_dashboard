# ignore __init__.py files
**/__init__.py

# ignore compiled Python files
**/*.pyc
**/*.pyo
**/__pycache__/

# ignore virtual environment directories
venv/
env/
.virtualenv/

# pipeline/ writes large intermediate artifacts (raw filings, chunks,
# embeddings) to a local data/ dir when run — keep those out of git.
# tickers.csv is the one small input file, tracked deliberately.
pipeline/data/*
!pipeline/data/tickers.csv

